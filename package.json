{
  "name": "agentphone-call-assistant",
  "version": "0.1.0",
  "description": "MCP server that places AI phone calls via AgentPhone and reports results by SMS",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "tsx src/setup.ts",
    "opt-in": "tsx src/optin.ts",
    "demo": "tsx scripts/call-demo.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentphone": "^1.0.25",
    "dotenv": "^16.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
