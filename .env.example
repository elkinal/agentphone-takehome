# AgentPhone API key (Settings -> API Keys in the AgentPhone dashboard)
AGENTPHONE_API_KEY=

# Where place_call's final SMS report goes by default (E.164, e.g. +15551234567).
# Can be overridden per-call via the notifyPhoneNumber tool argument.
USER_PHONE_NUMBER=

# Filled in automatically by `npm run setup` -- the agent/number this server calls from.
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=

# How often (ms) the background poller checks on in-progress calls.
POLL_INTERVAL_MS=5000
